{% extends "certificates/base_student.html" %}

{% block title %}Bo'lim boshlig'i paneli{% endblock %}

{% block extra_css %}
<style>
    .dept-header {
        background: linear-gradient(135deg, #1e3a5f 0%, #2c5282 100%);
        color: white;
        padding: 30px 40px;
        border-radius: 15px;
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 30px rgba(30, 58, 95, 0.3);
    }
    .dept-header h2 {
        font-size: 28px;
        margin-bottom: 5px;
        font-weight: 700;
    }
    .dept-header p {
        opacity: 0.85;
        font-size: 15px;
    }
    .date-badge {
        background: rgba(255,255,255,0.15);
        padding: 15px 25px;
        border-radius: 10px;
        text-align: right;
    }
    .date-badge .day {
        font-size: 32px;
        font-weight: 700;
        line-height: 1;
    }
    .date-badge .month-year {
        font-size: 14px;
        opacity: 0.9;
        margin-top: 5px;
    }
    
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    .kpi-card {
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        border-left: 4px solid #1e3a5f;
        transition: transform 0.2s;
    }
    .kpi-card:hover { transform: translateY(-3px); }
    .kpi-card.blue { border-left-color: #3182ce; }
    .kpi-card.green { border-left-color: #48bb78; }
    .kpi-card.orange { border-left-color: #ed8936; }
    .kpi-card.purple { border-left-color: #805ad5; }
    .kpi-card.red { border-left-color: #e53e3e; }
    
    .kpi-icon {
        font-size: 28px;
        margin-bottom: 10px;
    }
    .kpi-value {
        font-size: 36px;
        font-weight: 700;
        color: #1a202c;
        line-height: 1;
        margin-bottom: 8px;
    }
    .kpi-label {
        font-size: 13px;
        color: #718096;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }
    .kpi-sub {
        font-size: 12px;
        color: #a0aec0;
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid #edf2f7;
    }
    
    .dashboard-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 25px;
        margin-bottom: 25px;
    }
    @media (max-width: 1024px) {
        .dashboard-grid { grid-template-columns: 1fr; }
    }
    
    .section {
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #edf2f7;
    }
    .section-header h3 {
        color: #1a202c;
        font-size: 18px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .section-header .count {
        background: #edf2f7;
        color: #4a5568;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }
    
    .alerts-container {
        display: grid;
        gap: 15px;
        margin-bottom: 25px;
    }
    .alert {
        padding: 18px 20px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 15px;
        border-left: 4px solid;
    }
    .alert.warning {
        background: #fffaf0;
        border-left-color: #ed8936;
        color: #7b341e;
    }
    .alert.info {
        background: #ebf8ff;
        border-left-color: #3182ce;
        color: #2c5282;
    }
    .alert.success {
        background: #f0fff4;
        border-left-color: #48bb78;
        color: #22543d;
    }
    .alert-icon { font-size: 24px; }
    .alert-content h4 {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 3px;
    }
    .alert-content p {
        font-size: 13px;
        opacity: 0.85;
    }
    
    .schedule-item {
        padding: 15px;
        background: #f7fafc;
        border-radius: 8px;
        margin-bottom: 10px;
        border-left: 4px solid #48bb78;
    }
    .schedule-item h4 {
        font-size: 14px;
        color: #2d3748;
        margin-bottom: 5px;
    }
    .schedule-meta {
        display: flex;
        gap: 15px;
        font-size: 12px;
        color: #718096;
        flex-wrap: wrap;
    }
    .schedule-meta span {
        display: flex;
        align-items: center;
        gap: 4px;
    }
    
    .group-item {
        padding: 15px;
        background: #f7fafc;
        border-radius: 8px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .group-item h4 {
        font-size: 15px;
        color: #2d3748;
        margin-bottom: 3px;
    }
    .group-item p {
        font-size: 12px;
        color: #718096;
    }
    .group-badge {
        background: #1e3a5f;
        color: white;
        padding: 5px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }
    
    .lecturer-item {
        padding: 15px;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .lecturer-item:last-child { border-bottom: none; }
    .lecturer-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 16px;
    }
    .lecturer-info { flex: 1; }
    .lecturer-info h4 {
        font-size: 14px;
        color: #2d3748;
        margin-bottom: 3px;
    }
    .lecturer-stats {
        font-size: 12px;
        color: #718096;
    }
    
    .chart-container {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        height: 150px;
        gap: 15px;
        padding: 10px 0;
    }
    .chart-bar-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
    }
    .chart-bar {
        width: 100%;
        background: linear-gradient(180deg, #3182ce 0%, #1e3a5f 100%);
        border-radius: 6px 6px 0 0;
        position: relative;
        min-height: 8px;
        transition: all 0.3s;
    }
    .chart-bar:hover {
        background: linear-gradient(180deg, #63b3ed 0%, #2c5282 100%);
    }
    .chart-bar-value {
        position: absolute;
        top: -22px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 12px;
        font-weight: 700;
        color: #2d3748;
    }
    .chart-bar-label {
        font-size: 11px;
        color: #718096;
        margin-top: 8px;
        font-weight: 600;
    }
    
    .empty-state {
        text-align: center;
        padding: 30px 20px;
        color: #a0aec0;
    }
    .empty-state-icon {
        font-size: 40px;
        margin-bottom: 10px;
        opacity: 0.5;
    }
</style>
{% endblock %}

{% block content %}
<!-- ШАПКА -->
<div class="dept-header">
    <div>
        <h2>👋 Xush kelibsiz, {{ request.user.first_name|default:request.user.username }}!</h2>
        <p>Bo'lim boshlig'i paneli - Jadval va davomat nazorati</p>
    </div>
    <div class="date-badge">
        <div class="day">{{ today|date:"d" }}</div>
        <div class="month-year">{{ today|date:"F Y" }}</div>
    </div>
</div>

<!-- АЛЕРТЫ -->
{% if alerts %}
<div class="alerts-container">
    {% for alert in alerts %}
    <div class="alert {{ alert.type }}">
        <div class="alert-icon">{{ alert.icon }}</div>
        <div class="alert-content">
            <h4>{{ alert.title }}</h4>
            <p>{{ alert.message }}</p>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<!-- KPI КАРТОЧКИ -->
<div class="kpi-grid">
    <div class="kpi-card blue">
        <div class="kpi-icon">👥</div>
        <div class="kpi-value">{{ total_groups }}</div>
        <div class="kpi-label">Jami guruhlar</div>
        <div class="kpi-sub">{{ active_groups }} faol</div>
    </div>
    
    <div class="kpi-card green">
        <div class="kpi-icon">🎓</div>
        <div class="kpi-value">{{ total_students }}</div>
        <div class="kpi-label">Tinglovchilar</div>
        <div class="kpi-sub">Barcha talabalar</div>
    </div>
    
    <div class="kpi-card orange">
        <div class="kpi-icon">👨🏫</div>
        <div class="kpi-value">{{ total_lecturers }}</div>
        <div class="kpi-label">O'qituvchilar</div>
        <div class="kpi-sub">Faol ma'ruzachilar</div>
    </div>
    
    <div class="kpi-card purple">
        <div class="kpi-icon"></div>
        <div class="kpi-value">{{ today_schedules }}</div>
        <div class="kpi-label">Bugungi darslar</div>
        <div class="kpi-sub">{{ week_schedules }} haftada</div>
    </div>
    
    <div class="kpi-card red">
        <div class="kpi-icon">📊</div>
        <div class="kpi-value">{{ attendance_rate }}%</div>
        <div class="kpi-label">Davomat</div>
        <div class="kpi-sub">O'rtacha ko'rsatkich</div>
    </div>
    
    <div class="kpi-card">
        <div class="kpi-icon">📋</div>
        <div class="kpi-value">{{ total_schedules }}</div>
        <div class="kpi-label">Jami darslar</div>
        <div class="kpi-sub">Barcha vaqtlar</div>
    </div>
</div>


<!-- БЫСТРЫЕ ДЕЙСТВИЯ -->
<div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); margin-bottom: 30px;">
    <h3 style="color: #1e3a5f; margin-bottom: 20px; font-size: 20px;">⚡ Tezkor boshqaruv</h3>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
        <a href="{% url 'certificates:schedule_create' %}" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 25px; border-radius: 12px; text-decoration: none; display: block; transition: transform 0.3s;">
            <div style="font-size: 32px; margin-bottom: 10px;">📅</div>
            <div style="font-size: 18px; font-weight: 600; margin-bottom: 5px;">Dars jadvalini yaratish</div>
            <div style="font-size: 14px; opacity: 0.9;">Yangi dars qo'shish</div>
        </a>
        
        <a href="{% url 'certificates:group_create' %}" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 25px; border-radius: 12px; text-decoration: none; display: block; transition: transform 0.3s;">
            <div style="font-size: 32px; margin-bottom: 10px;"></div>
            <div style="font-size: 18px; font-weight: 600; margin-bottom: 5px;">Guruh yaratish</div>
            <div style="font-size: 14px; opacity: 0.9;">Yangi o'quv guruhi ochish</div>
        </a>
        
        <a href="{% url 'certificates:assign_lecturer' %}" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; padding: 25px; border-radius: 12px; text-decoration: none; display: block; transition: transform 0.3s;">
            <div style="font-size: 32px; margin-bottom: 10px;">👨‍🏫</div>
            <div style="font-size: 18px; font-weight: 600; margin-bottom: 5px;">O'qituvchi tayinlash</div>
            <div style="font-size: 14px; opacity: 0.9;">Kursga o'qituvchi biriktirish</div>
        </a>
    </div>
</div>

<!-- УПРАВЛЕНИЕ РАСПИСАНИЕМ -->
{% if recent_schedules %}
<div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="color: #1e3a5f; font-size: 20px; margin: 0;">📋 So'nggi darslar</h3>
        <a href="{% url 'certificates:schedule_create' %}" style="background: #48bb78; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600;">
             Yangi dars
        </a>
    </div>
    
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f7fafc; border-bottom: 2px solid #edf2f7;">
                    <th style="padding: 12px; text-align: left;">Kurs</th>
                    <th style="padding: 12px; text-align: left;">Guruh</th>
                    <th style="padding: 12px; text-align: left;">O'qituvchi</th>
                    <th style="padding: 12px; text-align: left;">Sana</th>
                    <th style="padding: 12px; text-align: center;">Holat</th>
                    <th style="padding: 12px; text-align: center;">Amallar</th>
                </tr>
            </thead>
            <tbody>
                {% for schedule in recent_schedules %}
                <tr style="border-bottom: 1px solid #edf2f7;">
                    <td style="padding: 12px; color: #1e3a5f; font-weight: 600;">{{ schedule.course.title }}</td>
                    <td style="padding: 12px; color: #4a5568;">{{ schedule.group.name }}</td>
                    <td style="padding: 12px; color: #4a5568;">{{ schedule.lecturer.get_full_name }}</td>
                    <td style="padding: 12px; color: #718096; font-size: 14px;">{{ schedule.date_start|date:"d.m.Y H:i" }}</td>
                    <td style="padding: 12px; text-align: center;">
                        <span style="background: {% if schedule.status == 'published' %}#48bb78{% elif schedule.status == 'draft' %}#ed8936{% else %}#e53e3e{% endif %}; color: white; padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                            {{ schedule.get_status_display }}
                        </span>
                    </td>
                    <td style="padding: 12px; text-align: center;">
                        <a href="{% url 'certificates:schedule_edit' schedule.id %}" style="color: #4299e1; margin-right: 10px;">✏️</a>
                        <a href="{% url 'certificates:schedule_delete' schedule.id %}" style="color: #e53e3e;">🗑️</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<!-- УПРАВЛЕНИЕ ГРУППАМИ -->
{% if groups %}
<div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="color: #1e3a5f; font-size: 20px; margin: 0;">👥 O'quv guruhlari</h3>
        <a href="{% url 'certificates:group_create' %}" style="background: #48bb78; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600;">
             Yangi guruh
        </a>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 15px;">
        {% for group in groups %}
        <div style="background: #f7fafc; padding: 20px; border-radius: 8px; border-left: 4px solid #4299e1;">
            <div style="font-weight: 600; color: #1e3a5f; margin-bottom: 8px;">{{ group.name }}</div>
            <div style="font-size: 14px; color: #718096; margin-bottom: 5px;">📚 {{ group.course.title }}</div>
            <div style="font-size: 14px; color: #718096; margin-bottom: 5px;">📅 {{ group.start_date|date:"d.m.Y" }} - {{ group.end_date|date:"d.m.Y" }}</div>
            <div style="font-size: 14px; color: #718096;">👥 {{ group.max_students }} talabaga mo'ljallangan</div>
            <div style="margin-top: 10px;">
                <a href="{% url 'certificates:group_edit' group.id %}" style="color: #4299e1; margin-right: 10px;">✏️ Tahrirlash</a>
                <a href="{% url 'certificates:group_delete' group.id %}" style="color: #e53e3e;">🗑️ O'chirish</a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- КУРСЫ БЕЗ ЛЕКТОРОВ -->
{% if courses_without_lecturer %}
<div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); margin-bottom: 30px;">
    <h3 style="color: #e53e3e; font-size: 20px; margin-bottom: 20px;">⚠️ O'qituvchisi tayinlanmagan kurslar</h3>
    
    <div style="display: grid; gap: 10px;">
        {% for course in courses_without_lecturer %}
        <div style="background: #fff5f5; padding: 15px; border-radius: 8px; border-left: 4px solid #e53e3e; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="font-weight: 600; color: #1e3a5f;">{{ course.title }}</div>
                <div style="font-size: 14px; color: #718096;">📚 {{ course.code }} | {{ course.duration_hours }} soat</div>
            </div>
            <a href="{% url 'certificates:assign_lecturer' %}?course={{ course.id }}" style="background: #48bb78; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600;">
                👨‍🏫 O'qituvchi tayinlash
            </a>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- ОСНОВНОЙ ГРИД -->
<div class="dashboard-grid">
    <!-- БЛИЖАЙШИЕ ЗАНЯТИЯ -->
    <div class="section">
        <div class="section-header">
            <h3>📅 Yaqinlashayotgan darslar</h3>
            <span class="count">{{ upcoming_schedules|length }}</span>
        </div>
        {% if upcoming_schedules %}
        <div>
            {% for schedule in upcoming_schedules %}
            <div class="schedule-item">
                <h4>{{ schedule.course|default:"Kurs yo'q" }}</h4>
                <div class="schedule-meta">
                    <span>📅 {{ schedule.date|date:"d.m.Y" }}</span>
                    <span> {{ schedule.start_time|date:"H:i" }} - {{ schedule.end_time|date:"H:i" }}</span>
                    {% if schedule.teacher %}<span>👨‍🏫 {{ schedule.teacher.get_full_name|default:schedule.teacher.username|truncatechars:20 }}</span>{% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">📅</div>
            <p>Rejalashtirilgan darslar yo'q</p>
        </div>
        {% endif %}
    </div>
    
    <!-- ТОП ПРЕПОДАВАТЕЛЕЙ -->
    <div class="section">
        <div class="section-header">
            <h3>👨‍🏫 Eng ko'p dars beradigan o'qituvchilar</h3>
        </div>
        {% if top_lecturers %}
        <div>
            {% for lecturer in top_lecturers %}
            <div class="lecturer-item">
                <div class="lecturer-avatar">
                    {{ lecturer.first_name|slice:":1"|default:"?" }}{{ lecturer.last_name|slice:":1"|default:"" }}
                </div>
                <div class="lecturer-info">
                    <h4>{{ lecturer.get_full_name|default:lecturer.username }}</h4>
                    <div class="lecturer-stats"> {{ lecturer.schedule_count }} dars</div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">👥</div>
            <p>Faol o'qituvchilar yo'q</p>
        </div>
        {% endif %}
    </div>
</div>

<!-- ВТОРОЙ ГРИД -->
<div class="dashboard-grid">
        <!-- СТАТИСТИКА ПО ДНЯМ НЕДЕЛИ -->
    <div class="section">
        <div class="section-header">
            <h3>📊 Haftalik darslar statistikasi</h3>
        </div>
        <div class="chart-container">
            {% for stat in daily_attendance %}
            <div class="chart-bar-wrapper">
                <div class="chart-bar" style="height: {% widthratio stat.schedules max_daily 100 %}%; margin-top: auto;">
                    {% if stat.schedules > 0 %}
                    <div class="chart-bar-value">{{ stat.schedules }}</div>
                    {% endif %}
                </div>
                <div class="chart-bar-label">{{ stat.day }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
