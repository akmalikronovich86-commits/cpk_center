@login_required
def student_update(request, student_id):
    """Редактирование записи о студенте"""
    from apps.groups.models import StudentRecord
    from .forms import StudentRecordForm
    student = get_object_or_404(StudentRecord, id=student_id)
    if request.method == 'POST':
        form = StudentRecordForm(request.POST, instance=student)
        if form.is_valid():
            form.save()
            messages.success(request, "Tinglovchi ma'lumotlari yangilandi!")
            return redirect('kpi:student_list')
    else:
        form = StudentRecordForm(instance=student)
    
    return render(request, 'kpi/student_form.html', {'form': form, 'title': "Tinglovchini tahrirlash"})

@login_required
def student_delete(request, student_id):
    """Удаление записи о студенте"""
    from apps.groups.models import StudentRecord
    student = get_object_or_404(StudentRecord, id=student_id)
    if request.method == 'POST':
        student.delete()
        messages.success(request, "Tinglovchi o'chirildi!")
        return redirect('kpi:student_list')
    return render(request, 'kpi/confirm_delete.html', {'object': student, 'type': "Tinglovchi"})
