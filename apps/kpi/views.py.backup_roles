# ============ УПРАВЛЕНИЕ СТУДЕНТАМИ (Tinglovchilar) ============

@login_required
def student_list(request):
    """Список студентов"""
    from apps.groups.models import StudentRecord, TrainingYear
    students = StudentRecord.objects.all().order_by('full_name')
    
    # Фильтры
    year = request.GET.get('year')
    if year:
        students = students.filter(training_year_id=year)
    
    years = TrainingYear.objects.all()
    context = {
        'students': students,
        'years': years,
        'current_year': year,
    }
    return render(request, 'kpi/student_list.html', context)

